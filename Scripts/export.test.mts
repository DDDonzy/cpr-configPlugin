import test from 'node:test'
import assert from 'node:assert/strict'
import {createRequire} from 'node:module'
import {readFileSync,writeFileSync} from 'node:fs'
import {buildExport,formatCodex,toCodex} from '../frontend/src/models/codexExport.ts'
const model={display_name:'GPT-6 Astra',reasoning_levels:['low','medium','high','xhigh','max'],context_window:1050000,max_output_tokens:128000,input_modalities:['text','image']}
const data={'gpt-6-astra':model}
test('Codex follows the user template exactly',()=>{assert.deepEqual(toCodex(data,['gpt-6-astra']),{models:[{slug:'gpt-6-astra',display_name:'GPT-6 Astra',supported_reasoning_levels:[{effort:'low',description:'Low reasoning effort'},{effort:'medium',description:'Medium reasoning effort'},{effort:'high',description:'High reasoning effort'},{effort:'xhigh',description:'Extra-high reasoning effort'},{effort:'max',description:'Maximum reasoning effort'},{effort:'ultra',description:'Ultra reasoning effort'}],shell_type:'unified_exec',visibility:'list',supported_in_api:true,priority:0,base_instructions:'You are a coding assistant. Help the user complete their task using the available tools.',support_verbosity:true,truncation_policy:{mode:'tokens',limit:128000},experimental_supported_tools:[],context_window:1050000,max_context_window:1050000,input_modalities:['text','image'],supports_reasoning_summary_parameter:true}]})})
test('default effort and max_output_tokens omitted; ultra appended only to Codex',()=>{const out=toCodex(data,['gpt-6-astra']).models[0];assert.ok(!Object.hasOwn(out,'default_reasoning_level'));assert.ok(!Object.hasOwn(out,'max_output_tokens'));assert.equal(out.supported_reasoning_levels.filter(x=>x.effort==='ultra').length,1);assert.ok(!data['gpt-6-astra'].reasoning_levels.includes('ultra'))})
test('truncation budget is fixed and independent of output limit',()=>{for(const limit of [undefined,256000,100]){const m={...model,max_output_tokens:limit};if(limit===undefined)delete m.max_output_tokens;assert.equal(toCodex({m},['m']).models[0].truncation_policy.limit,128000)}})
test('array order and priority follow current model order',()=>{const out=toCodex({a:model,b:model},['b','a']);assert.deepEqual(out.models.map(m=>m.slug),['b','a']);assert.deepEqual(out.models.map(m=>m.priority),[0,1])})
test('numeric IDs use explicit order rather than object enumeration',()=>assert.deepEqual(toCodex({'2':model,'10':model},['10','2']).models.map(x=>x.slug),['10','2']))
test('Base retains max_output_tokens and only basic fields',()=>{const bundle=buildExport(data,['gpt-6-astra']);assert.deepEqual(JSON.parse(bundle.base.text),data);assert.equal(JSON.parse(bundle.base.text)['gpt-6-astra'].max_output_tokens,128000)})
test('unsupported Codex video does not block Base export',()=>{const source={video:{...model,input_modalities:['text','video']}};const bundle=buildExport(source,['video']);assert.equal(bundle.codex.text,null);assert.match(bundle.codex.error,/video/);assert.deepEqual(JSON.parse(bundle.base.text),source)})
test('valid audio can be represented',()=>assert.deepEqual(toCodex({audio:{...model,input_modalities:['text','audio']}},['audio']).models[0].input_modalities,['text','audio']))
test('invalid order is rejected instead of dropping entries',()=>assert.throws(()=>buildExport({a:model,b:model},['a'])))
test('format uses multiline model objects and inline arrays/level entries',()=>{const text=formatCodex(toCodex(data,['gpt-6-astra']));assert.ok(text.includes('"input_modalities": ["text", "image"]'));assert.ok(text.includes('{"effort": "low", "description": "Low reasoning effort"}'));assert.deepEqual(JSON.parse(text),toCodex(data,['gpt-6-astra']))})
test('quoting and punctuation in user strings are not altered',()=>{const source={'id":test':{...model,display_name:'A":B, "C" 中文'}};assert.deepEqual(JSON.parse(formatCodex(toCodex(source,['id":test']))),toCodex(source,['id":test']))})
test('empty models export as valid Base and Codex JSON',()=>{const bundle=buildExport({},[]);assert.deepEqual(JSON.parse(bundle.base.text),{});assert.deepEqual(JSON.parse(bundle.codex.text),{models:[]})})
test('export is a consistent snapshot without mutating source',()=>{const source={a:{...model,reasoning_levels:[...model.reasoning_levels]}};const before=structuredClone(source);const bundle=buildExport(source,['a'],'models.common.json',true);assert.deepEqual(source,before);source.a.display_name='Changed later';assert.equal(JSON.parse(bundle.base.text).a.display_name,model.display_name);assert.equal(JSON.parse(bundle.codex.text).models[0].display_name,model.display_name);assert.equal(bundle.isDraft,true)})
const require=createRequire(new URL('../frontend/package.json',import.meta.url)),vue=require('vue'),ts=require('typescript')
const {parse,compileScript}=require('@vue/compiler-sfc')
const source=readFileSync(new URL('../frontend/src/models/components/JsonExportDialog.vue',import.meta.url),'utf8')
const compiled=ts.transpileModule(compileScript(parse(source).descriptor,{id:'export-test'}).content,{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText
function dialog(){const doc=vue.ref(null),out={};new Function('require','exports',compiled)(id=>id==='vue'?vue:id==='../api'?{exportDocument:doc}:{},out);const scope=vue.effectScope();const d=scope.run(()=>out.default.setup({}, {expose(){},emit(){}}));return{d,doc,scope}}
test('dialog begins in Base; switching selects Codex text and clears feedback',async()=>{const a=dialog();a.doc.value=buildExport(data,['gpt-6-astra']);await vue.nextTick();assert.equal(a.d.tab.value,'base');assert.deepEqual(JSON.parse(a.d.active.value.text),data);a.d.feedback.value='old';a.d.tab.value='codex';await vue.nextTick();assert.deepEqual(JSON.parse(a.d.active.value.text),toCodex(data,['gpt-6-astra']));assert.equal(a.d.feedback.value,'');a.scope.stop()})
test('each export resets tab and captures a new snapshot',async()=>{const a=dialog();a.doc.value=buildExport(data,['gpt-6-astra']);await vue.nextTick();a.d.tab.value='codex';a.doc.value=buildExport({b:model},['b']);await vue.nextTick();assert.equal(a.d.tab.value,'base');assert.ok(Object.hasOwn(JSON.parse(a.d.active.value.text),'b'));a.scope.stop()})
test('copy uses selected tab text, never the other tab',async()=>{const original=Object.getOwnPropertyDescriptor(globalThis,'navigator');const copied=[];Object.defineProperty(globalThis,'navigator',{configurable:true,value:{clipboard:{writeText:async text=>copied.push(text)}}});try{const a=dialog();a.doc.value=buildExport(data,['gpt-6-astra']);await vue.nextTick();a.d.tab.value='codex';await vue.nextTick();await a.d.copy();assert.deepEqual(JSON.parse(copied[0]),toCodex(data,['gpt-6-astra']));assert.match(a.d.feedback.value,/Codex/);a.scope.stop()}finally{if(original)Object.defineProperty(globalThis,'navigator',original);else delete globalThis.navigator}})
test('conversion failure does not copy invalid Codex',async()=>{const a=dialog();a.doc.value=buildExport({video:{...model,input_modalities:['video']}},['video']);await vue.nextTick();a.d.tab.value='codex';await a.d.copy();assert.equal(a.d.active.value.text,null);assert.match(a.d.active.value.error,/video/);a.scope.stop()})

test('Codex download opens link dialog instead of attempting sandbox download',()=>{const a=dialog();a.doc.value=buildExport(data,['gpt-6-astra']);a.d.downloadBat();assert.equal(a.d.batDialogOpen.value,true);assert.equal(a.d.batLink,'https://github.com/DDDonzy/cpr-configPlugin/releases/latest/download/codex-setup.bat');assert.ok(!source.includes("link.click()"));assert.ok(!source.includes("allow-downloads"));a.scope.stop()})
test('link copy has a safe manual fallback',async()=>{const original=Object.getOwnPropertyDescriptor(globalThis,'navigator');Object.defineProperty(globalThis,'navigator',{configurable:true,value:{}});try{const a=dialog();await a.d.copyBatLink();assert.match(a.d.batFeedback.value,/Ctrl\+C/);a.scope.stop()}finally{if(original)Object.defineProperty(globalThis,'navigator',original);else delete globalThis.navigator}})
