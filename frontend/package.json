{
  "name": "cpr-config-plugin-ui",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build --mode routing && vite build --mode models",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite --mode models --host 127.0.0.1",
    "format": "prettier --write --single-quote --no-semi src vite.config.ts"
  },
  "dependencies": {
    "@codex-proxy/ui": "file:vendor/codex-proxy-ui-0.4.0.tgz",
    "@lucide/vue": "1.53.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.12"
  }
}
